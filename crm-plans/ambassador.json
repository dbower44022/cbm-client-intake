{
  "name": "ambassador",
  "description": "The Ambassador Program (prds/Ambassador Program/ambassador-program-prd.md § 7; decisions AM1 to AM7, approved by Doug 11-21-26). CAmbassadorActivity: one record per report a member submits, linked to the member's mentor profile and assigned to their login (Multiple Assigned Users), so the Mentor Role's 'own' grant lets them read and correct it. Referred by links on Contact, CEngagement, CPartnerProfile and CSponsorProfile credit a referral. New option values: CSession.sessionType 'Ambassador Contact' (every session count in the application ignores it) and CProspect.leadSource 'Ambassador referral'. Additive only. No field Read-only: the application writes them all (ruling 40). Handoff: ambassador-activity-crm-handoff.md. Role grants: scripts/migrate_ambassador_roles.py.",
  "entities": [
    {
      "name": "AmbassadorActivity",
      "type": "Base",
      "labelSingular": "Ambassador Activity",
      "labelPlural": "Ambassador Activities",
      "stream": true
    }
  ],
  "entityParams": [
    {
      "entity": "CAmbassadorActivity",
      "params": {
        "assignedUsers": true,
        "collaborators": true
      }
    }
  ],
