        <mxCell id="vo_e4" style="endArrow=classic;" edge="1" source="vo_profile" target="vo_close" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="vo_e5" style="endArrow=classic;" edge="1" source="vo_close" target="vo_end" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="partner" name="4 · Become a Partner">
