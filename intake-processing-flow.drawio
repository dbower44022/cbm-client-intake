        <mxCell id="pa_contact" value="The applicant is looked up by email — or added" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="180" y="310" width="280" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="pa_profile" value="A partnership record is created and marked &quot;Candidate&quot; — meaning: a new application, not yet reviewed" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="180" y="400" width="280" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="pa_close" value="Delivered ✓ — takes itself off the Submission Admin list. Nothing to do there" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="180" y="510" width="280" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="pa_end" value="The work continues in PARTNER MANAGEMENT: every &quot;Candidate&quot; partnership is waiting for review — that&#39;s the number on the portal badge. Advancing its status IS the approval" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1">
          <mxGeometry x="180" y="610" width="280" height="100" as="geometry"/>
