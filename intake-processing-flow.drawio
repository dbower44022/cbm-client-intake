          <mxGeometry x="180" y="510" width="280" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="sf_end" value="The work continues in FUNDER MANAGEMENT: a funder with no manager is waiting for someone to take it on — that&#39;s the number on the portal badge. Assigning a funder manager clears it" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1">
