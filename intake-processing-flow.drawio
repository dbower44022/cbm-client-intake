  <diagram id="inforequest" name="6 · Information request">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1000">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="ir_start" value="Someone asks a question through the website (/info-request)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#4A9EFF;fontColor=#FFFFFF;strokeColor=#2D7CD6;" vertex="1" parent="1">
          <mxGeometry x="180" y="20" width="280" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="ir_pipe" value="Goes through the standard journey on tab 1 (saved instantly, delivered in the background)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="180" y="110" width="280" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="ir_known" value="Have we heard from this email address before?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="220" y="210" width="200" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="ir_append" value="Their new message is added to their existing record — no duplicate person is created" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="540" y="225" width="260" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="ir_contact" value="They&#39;re added to the CRM as a new prospect, with their message" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="180" y="340" width="280" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="ir_company" value="Did they name a company?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="220" y="440" width="200" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="ir_acct" value="The company is added too" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="540" y="455" width="260" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="ir_req" value="An information-request record is created so the question can be tracked to an answer" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="180" y="560" width="280" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="ir_open" value="Delivered ✓ — but unlike the other forms it STAYS on the Submission Admin list, because someone owes this person an answer (that&#39;s the number on the /ops badge)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1">
          <mxGeometry x="180" y="660" width="280" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="ir_reply" value="Staff answer by email straight from the submission — the reply goes out as info@cbmentors.org and the whole conversation stays attached to it" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="180" y="790" width="280" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="ir_end" value="Staff close it with a reason (answered, referred, junk, …) and it drops off the list. If the person writes back later, it pops back on by itself" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="180" y="910" width="280" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="ir_e1" style="endArrow=classic;" edge="1" source="ir_start" target="ir_pipe" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ir_e2" style="endArrow=classic;" edge="1" source="ir_pipe" target="ir_known" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ir_e3" value="Yes" style="endArrow=classic;" edge="1" source="ir_known" target="ir_append" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ir_e4" value="No" style="endArrow=classic;" edge="1" source="ir_known" target="ir_contact" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ir_e5" style="endArrow=classic;curved=1;" edge="1" source="ir_append" target="ir_company" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ir_e6" style="endArrow=classic;" edge="1" source="ir_contact" target="ir_company" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ir_e7" value="Yes" style="endArrow=classic;" edge="1" source="ir_company" target="ir_acct" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ir_e8" value="No" style="endArrow=classic;" edge="1" source="ir_company" target="ir_req" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ir_e9" style="endArrow=classic;curved=1;" edge="1" source="ir_acct" target="ir_req" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ir_e10" style="endArrow=classic;" edge="1" source="ir_req" target="ir_open" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ir_e11" style="endArrow=classic;" edge="1" source="ir_open" target="ir_reply" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ir_e12" style="endArrow=classic;" edge="1" source="ir_reply" target="ir_end" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="infoemail" name="7 · Email to info@">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1000">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="ie_start" value="An email arrives at info@cbmentors.org" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#4A9EFF;fontColor=#FFFFFF;strokeColor=#2D7CD6;" vertex="1" parent="1">
          <mxGeometry x="180" y="20" width="280" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="ie_poll" value="The app checks the mailbox every few minutes" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="180" y="110" width="280" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="ie_known" value="Is it a reply to a conversation we already have?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="210" y="200" width="220" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="ie_thread" value="It simply joins that conversation — nothing new to triage. If that item had been closed, the reply automatically puts it back on the list" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="560" y="210" width="280" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="ie_capture" value="Held as a NEW item for a human to look at first — status Held-Email. Its CRM receipt (with the email content) is written immediately" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="180" y="350" width="280" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="ie_queue" value="Shows on the Submission Admin list for a decision (that&#39;s part of the /ops badge number)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1">
          <mxGeometry x="180" y="450" width="280" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="ie_decide" value="Staff decision" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="240" y="550" width="160" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="ie_approve" value="APPROVE: it&#39;s a real inquiry — handled exactly like an information request (tab 6): the person and a tracking record are created in the CRM" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="180" y="680" width="280" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="ie_open" value="Someone owes them an answer: staff reply as info@ on the same email thread, then close it with a reason and it drops off the list" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="180" y="800" width="280" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="ie_discard" value="DISCARD (reason required): junk. Status Discarded — the CRM receipt records who, when, and why; no business records are ever created" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FF6B6B;fontColor=#FFFFFF;strokeColor=#C0392B;" vertex="1" parent="1">
          <mxGeometry x="560" y="680" width="280" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="ie_e1" style="endArrow=classic;" edge="1" source="ie_start" target="ie_poll" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ie_e2" style="endArrow=classic;" edge="1" source="ie_poll" target="ie_known" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ie_e3" value="Yes" style="endArrow=classic;" edge="1" source="ie_known" target="ie_thread" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ie_e4" value="No — someone new" style="endArrow=classic;" edge="1" source="ie_known" target="ie_capture" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ie_e5" style="endArrow=classic;" edge="1" source="ie_capture" target="ie_queue" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ie_e6" style="endArrow=classic;" edge="1" source="ie_queue" target="ie_decide" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ie_e7" value="Approve" style="endArrow=classic;" edge="1" source="ie_decide" target="ie_approve" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ie_e8" style="endArrow=classic;" edge="1" source="ie_approve" target="ie_open" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ie_e9" value="Discard" style="endArrow=classic;strokeColor=#C0392B;" edge="1" source="ie_decide" target="ie_discard" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
