  </diagram>
  <diagram id="volunteer" name="3 · Volunteer (become a mentor)">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="vo_start" value="Someone applies to become a mentor (/volunteer)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#4A9EFF;fontColor=#FFFFFF;strokeColor=#2D7CD6;" vertex="1" parent="1">
          <mxGeometry x="180" y="20" width="280" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="vo_pipe" value="Goes through the standard journey on tab 1 (saved instantly, delivered in the background)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="180" y="110" width="280" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="vo_contact" value="The person is looked up by email — or added — and marked as a mentor. Their resume, if attached, is stored on their record" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="180" y="210" width="280" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="vo_profile" value="A mentor profile is created and marked &quot;Candidate&quot; — meaning: a new application, not yet reviewed. Their expertise, industries and consents are stored on it" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="180" y="320" width="280" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="vo_close" value="Delivered ✓ — takes itself off the Submission Admin list. Nothing to do there" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="180" y="440" width="280" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="vo_end" value="The work continues in MENTOR ADMINISTRATION: every &quot;Candidate&quot; is an application waiting for review — that&#39;s the number on the portal badge. Approving them later creates their CBM login and email" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1">
          <mxGeometry x="180" y="540" width="280" height="100" as="geometry"/>
